# Copia para .env e preenche só a chave do fornecedor que usares.
# O .env está no .gitignore: as chaves nunca vão para o GitHub.

# https://console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=

# https://aistudio.google.com → Get API key (nível gratuito, sem cartão)
GOOGLE_API_KEY=

# Para fornecedor = "openai" com um serviço remoto (OpenRouter, Groq, Mistral...).
# Para llama-server ou Ollama locais, deixa vazio.
OPENAI_API_KEY=
